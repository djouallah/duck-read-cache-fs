# name: test/sql/mount.test
# description: paths under a mounted prefix are served from where it points
# group: [sql]

require cache_httpfs

require parquet

statement ok
COPY (SELECT 42 AS answer) TO '__TEST_DIR__/mounted_file.parquet' (FORMAT parquet);

# Nothing is mounted yet, and the folder doesn't exist.
statement error
SELECT answer FROM read_parquet('__TEST_DIR__/mount_point/mounted_file.parquet');
----

query I
SELECT cache_httpfs_mount('__TEST_DIR__/mount_point', '__TEST_DIR__');
----
true

query I
SELECT answer FROM read_parquet('__TEST_DIR__/mount_point/mounted_file.parquet');
----
42

# A glob too.
query I
SELECT answer FROM read_parquet('__TEST_DIR__/mount_point/mounted_*.parquet');
----
42

# A whole path segment: a sibling that begins the same isn't under it.
statement error
SELECT answer FROM read_parquet('__TEST_DIR__/mount_point2/mounted_file.parquet');
----

# Mounted again, and with a trailing slash, it's the same mount.
query I
SELECT cache_httpfs_mount('__TEST_DIR__/mount_point/', '__TEST_DIR__/');
----
true

query I
SELECT answer FROM read_parquet('__TEST_DIR__/mount_point/mounted_file.parquet');
----
42

query I
SELECT cache_httpfs_unmount('__TEST_DIR__/mount_point');
----
true

query I
SELECT cache_httpfs_unmount('__TEST_DIR__/mount_point');
----
false

statement error
SELECT answer FROM read_parquet('__TEST_DIR__/mount_point/mounted_file.parquet');
----

# A file that is really there under a mount is read where it is (a whole file kept on this machine), even where the
# mount points has one of that name; a file that isn't there is read from where the mount points.
statement ok
COPY (SELECT 7 AS answer, 1 AS p) TO '__TEST_DIR__/kept' (FORMAT parquet, PARTITION_BY (p), OVERWRITE_OR_IGNORE true);

statement ok
COPY (SELECT 8 AS answer, 1 AS p) TO '__TEST_DIR__/far' (FORMAT parquet, PARTITION_BY (p), OVERWRITE_OR_IGNORE true);

statement ok
COPY (SELECT 9 AS answer, 2 AS p) TO '__TEST_DIR__/far' (FORMAT parquet, PARTITION_BY (p), OVERWRITE_OR_IGNORE true);

query I
SELECT cache_httpfs_mount('__TEST_DIR__/kept', '__TEST_DIR__/far');
----
true

query I
SELECT answer FROM read_parquet('__TEST_DIR__/kept/p=1/data_0.parquet');
----
7

query I
SELECT answer FROM read_parquet('__TEST_DIR__/kept/p=2/data_0.parquet');
----
9

query I
SELECT cache_httpfs_unmount('__TEST_DIR__/kept');
----
true

# A mount can't reach what the database isn't allowed to.
statement ok
SET allowed_directories = ['__TEST_DIR__/mount_point'];

statement ok
SET enable_external_access = false;

statement error
SELECT cache_httpfs_mount('__TEST_DIR__/mount_point', '__TEST_DIR__');
----
is not allowed
